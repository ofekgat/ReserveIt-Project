# Copy this file to db.properties in the same folder, and fill in
# your local MySQL credentials. db.properties must NOT be committed
# to git — it belongs in .gitignore.

db.url=jdbc:mysql://localhost:3306/getticket?useSSL=false&serverTimezone=Asia/Jerusalem&characterEncoding=UTF-8
db.user=root
db.password=CHANGE_ME
db.pool.size=10
